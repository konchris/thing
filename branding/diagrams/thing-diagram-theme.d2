# THING D2 Theme Starter
#
# Import or copy this into primary D2 diagrams.
# D2 syntax support for variables/classes may depend on renderer version.

vars: {
  thing-bg: "#F3F1EC"
  thing-surface: "#FAF8F3"
  thing-ink: "#161616"
  thing-iron: "#252A2E"
  thing-stone: "#6E6B67"
  thing-line: "#C9C5BD"
  thing-line-strong: "#8B8780"
  thing-indigo: "#273248"
  thing-violet: "#4A4458"
  thing-moss: "#68736D"
  thing-risk: "#8A5A44"
}

classes: {
  artifact: {
    style: {
      fill: "#FAF8F3"
      stroke: "#161616"
      stroke-width: 1
      border-radius: 4
      font-color: "#161616"
    }
  }

  muted-artifact: {
    style: {
      fill: "#F3F1EC"
      stroke: "#C9C5BD"
      stroke-width: 1
      border-radius: 4
      font-color: "#6E6B67"
    }
  }

  boundary: {
    style: {
      fill: "#F3F1EC"
      stroke: "#8B8780"
      stroke-width: 1
      stroke-dash: 4
      border-radius: 6
      font-color: "#161616"
    }
  }

  accent: {
    style: {
      fill: "#FAF8F3"
      stroke: "#273248"
      stroke-width: 2
      border-radius: 4
      font-color: "#161616"
    }
  }

  risk: {
    style: {
      fill: "#FAF8F3"
      stroke: "#8A5A44"
      stroke-width: 2
      border-radius: 4
      font-color: "#161616"
    }
  }

  verified: {
    style: {
      fill: "#FAF8F3"
      stroke: "#68736D"
      stroke-width: 2
      border-radius: 4
      font-color: "#161616"
    }
  }
}
